[Unit]
Description=ESP fleet Slack bot (Can_TestBench/Slack_Bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Can_TestBench/Slack_Bot

# systemd does not read your shell profile. export.sh needs all three of these.
Environment=HOME=/home/pi
Environment=IDF_PATH=/home/pi/esp/esp-idf
Environment=IDF_TOOLS_PATH=/home/pi/.espressif

# Build cache lives outside the git checkout so `git clean` can't nuke it.
Environment=FLEET_WORKSPACE=/home/pi/.cache/esp-fleet-bot

# chmod 600, owned by root. Holds SLACK_BOT_TOKEN and SLACK_APP_TOKEN.
EnvironmentFile=/etc/esp-fleet-bot.env

ExecStart=/home/pi/Can_TestBench/Slack_Bot/.venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target