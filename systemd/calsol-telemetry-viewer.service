[Unit]
Description=Local-only CalSol telemetry viewer (use SSH forwarding)
After=network.target
[Service]
DynamicUser=yes
Environment=CALSOL_WEB_ROOT=/opt/calsol/CAN_TestBench/web
Environment=CALSOL_WEB_PORT=8080
EnvironmentFile=-/etc/calsol/viewer.env
ExecStart=/usr/bin/python3 -m http.server ${CALSOL_WEB_PORT} --bind 127.0.0.1 --directory ${CALSOL_WEB_ROOT}
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
[Install]
WantedBy=multi-user.target
