# CalSol CAN Testbench Persistent Device Mapping
# Place in /etc/udev/rules.d/99-calsol.rules

# Match by USB chip serial number (ESP32-S3 testbench nodes)
SUBSYSTEM=="tty", ATTRS{serial}=="E0:72:A1:FC:DC:94", SYMLINK+="steering esp32_dev1 esp32_johnathan", MODE="0666"
SUBSYSTEM=="tty", ATTRS{serial}=="E0:72:A1:FD:24:38", SYMLINK+="bms esp32_dev2 esp32_ahmed", MODE="0666"

# Generic board mappings by physical USB hub port
# SUBSYSTEM=="tty", KERNELS=="2-1.1:1.0", SYMLINK+="calsol_dev1", MODE="0666"
# SUBSYSTEM=="tty", KERNELS=="2-1.2:1.0", SYMLINK+="calsol_dev2", MODE="0666"
